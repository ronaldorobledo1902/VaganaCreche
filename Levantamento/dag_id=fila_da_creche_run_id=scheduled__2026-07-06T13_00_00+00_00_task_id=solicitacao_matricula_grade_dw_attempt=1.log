[2026-07-07T10:00:01.446-0300] {sql.py:254} INFO - Executing: /*
 * Essa query seleciona as solicitações de matrícula de quem ainda
 * não está na rede ('C' para Cadastro), faz join com a grade de distância
 * para retornar todas as unidades educacionais a que o solicitante concorre.
 * Ela também gera um número único aleatório para a solicitação,
 * de modo a anonimizar o dado para abertura.
 */
DROP TABLE IF EXISTS mat_pref;
create temporary table mat_pref as (
    select cd_solicitacao_matricula,
           cd_unidade_educacao,
           cd_solicitacao_matricula_preferencial
    from (
             select cd_solicitacao_matricula,
                    cd_unidade_educacao,
                    cd_solicitacao_matricula_preferencial,
                    row_number()
                    over (partition by cd_solicitacao_matricula order by cd_solicitacao_matricula_preferencial desc ) ordem
             from raw_eol.solicitacao_matricula_preferencial
             where tp_preferencia = 'E'
               and dt_fim isnull
               and cd_unidade_educacao is not null
         ) alu_pref
    where ordem = 1
);


DROP TABLE IF EXISTS sol_mat_status_s;
create temporary table sol_mat_status_s as (
    select soldw.cd_solicitacao_matricula, cd_serie_ensino, cd_unidade_educacao
    from dw_facts_eol.solicitacao_matricula_dw as soldw
    WHERE soldw.nm_tabela_origem = 'SOLICITACAO'
      AND soldw.st_solicitacao_atual = 'S'
      AND soldw.tp_origem = 'C'
      AND soldw.dt_status_solicitacao < NOW() - interval '30 days'  -- Solicitações feitas à mais de 30 dias
);


DROP TABLE IF EXISTS random_number;
create temporary table random_number as (
    SELECT cd_solicitacao_matricula_distinct,
           row_number() over (ORDER BY random()) AS cd_solicitacao_matricula_random
    FROM (
             SELECT DISTINCT cd_solicitacao_matricula AS cd_solicitacao_matricula_distinct
             FROM sol_mat_status_s
         ) AS temp
);


DROP TABLE IF EXISTS dw_facts_eol.solicitacao_matricula_grade_dw;
CREATE TABLE dw_facts_eol.solicitacao_matricula_grade_dw AS (
SELECT --solicit.cd_solicitacao_matricula,
       solicit.cd_serie_ensino,
       random_number.cd_solicitacao_matricula_random,
       grade.cd_solicitacao_matricula_grade_distancia,
       grade.cd_unidade_educacao,
       grade.in_elegivel_compatibilizacao,
       grade.in_grade_ano_corrente,
       grade.in_grade_ano_seguinte,
       --solicit.st_solicitacao
       grade.qt_distancia
FROM sol_mat_status_s AS solicit
         LEFT JOIN raw_eol.solicitacao_matricula_grade_distancia AS grade
                   ON solicit.cd_solicitacao_matricula = grade.cd_solicitacao_matricula
         LEFT JOIN random_number
                   ON solicit.cd_solicitacao_matricula = random_number.cd_solicitacao_matricula_distinct
         left join mat_pref pref on pref.cd_solicitacao_matricula = solicit.cd_solicitacao_matricula

WHERE grade.qt_distancia <= 2000
  and (pref.cd_solicitacao_matricula isnull -- sem preferencial
    or (pref.cd_solicitacao_matricula notnull and pref.cd_unidade_educacao = solicit.cd_unidade_educacao))
);
